# Copiar como backend/.env y completar. Nunca subir el .env real a git.

# --- Opción A: base de datos local (pgAdmin) ---
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agro_control_db

# --- Opción B: base de datos en la nube (Neon). Si se define, reemplaza a las DB_* ---
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Secreto de al menos 32 caracteres para firmar los JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma (por defecto: localhost y la app Android)
# CORS_ORIGINS=https://agro-control.vercel.app,https://localhost

# false para desactivar las lecturas simuladas cuando haya nodos ESP32 reales
SIMULAR_SENSORES=true

PORT=4000
